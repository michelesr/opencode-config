{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "edit", "resource": "*", "effect": "ask" },
  ],
  "agents": {
    "plan": {
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
      ],
    },
  },
  "providers": {
    "amazon-bedrock": {
      "settings": {
        "region": "eu-west-1",
        "profile": "bedrock",
      }
    }
  }
}
